# Copy this file to `.env` in the same folder (`backend/.env`) and set values.
# Never commit `.env` if it contains real secrets.

# Required for Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console).
# Same value as VITE_GOOGLE_CLIENT_ID in Frontend/.env.local
GOOGLE_OAUTH_CLIENT_ID=980917705542-ojkb8nanpjs29s47jipc80usatv4uvf9.apps.googleusercontent.com

# Comma-separated browser origins allowed to call this API with cookies (default if unset).
# INTELLIMODEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: full path to SQLite file for users/sessions (default: backend/data/intellimodel_users.db)
# INTELLIMODEL_SQLITE_PATH=

# Set to true in production (HTTPS) so the session cookie is Secure.
# INTELLIMODEL_COOKIE_SECURE=false

# Optional: training run catalog SQLite (default backend/data/training_catalog.db)
# TRAINING_CATALOG_SQLITE_PATH=

# Optional: enable warm-start decisioning (default false)
# TRAINING_MEMORY_DECISION_ENABLED=false

# Optional: warm-start policy [none|warm_start_if_compatible] (default none)
# TRAINING_MEMORY_POLICY=none

# Optional: promotion threshold for artifact scoring (default 0.0)
# TRAINING_MEMORY_PROMOTION_DELTA=0.0
